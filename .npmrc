# Stop before installation when Node/npm cannot run this project's tooling.
engine-strict=true
# New direct dependencies record the chosen version; npm ci still uses the lockfile.
save-exact=true
# Dependencies' install scripts never run (only esbuild and fsevents have one; neither needs it):
# a compromised package cannot run code on `npm ci`. `npm run` and `npm test` still run their own.
ignore-scripts=true
