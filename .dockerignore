**/node_modules
src-tauri/target
src-tauri/gen
release
scratch
.dev-data*
.credentials
.claude
.npm
.cache
**/.env*
**/*.pem
**/*.p12
**/*.p8
**/*.pfx
**/*.key
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.provisionprofile
website/dev
website/.vitepress/cache
website/.vitepress/dist
website/.vitepress/.temp
website/.vitepress/generated.json
website/public/pets
website/public/creator-kit
website/public/yard
**/.DS_Store
