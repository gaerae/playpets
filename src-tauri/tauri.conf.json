{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayPets",
  "version": "../package.json",
  "identifier": "app.playpets",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run licenses:check"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' pet-asset: http://pet-asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../packaging/licenses/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "publisher": "gaerae",
    "copyright": "Copyright (c) 2026 gaerae",
    "homepage": "https://playpets.gaerae.com/",
    "targets": ["app", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "A yard where your pets talk to each other",
    "longDescription": "An open-source desktop pet app. It reads Codex pet files as they are, gives each friend its own AI (a Claude Code or Codex subscription, Ollama, or an OpenAI-compatible server), lets friends talk among themselves, and keeps any coding agent company.",
    "category": "Entertainment",
    "windows": {
      "nsis": {
        "languages": ["English", "Korean", "Japanese", "SimpChinese"],
        "displayLanguageSelector": true,
        "sidebarImage": "../packaging/windows/nsis-sidebar.bmp",
        "headerImage": "../packaging/windows/nsis-header.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/playpets.desktop",
        "files": { "/usr/share/metainfo/app.playpets.metainfo.xml": "../packaging/linux/app.playpets.metainfo.xml" }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/app.playpets.metainfo.xml": "../packaging/linux/app.playpets.metainfo.xml",
          "/usr/share/common-licenses": "/usr/share/common-licenses",
          "/usr/share/doc/playpets-bundled-libraries": "target/appimage-license-docs"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "../packaging/macos/dmg-background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 165, "y": 225 },
        "applicationFolderPosition": { "x": 495, "y": 225 }
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["playpets"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMUQ2REQxQzlDOTA2QTMKUldTakJzbkowVzBkWDV3RTlEMjhXeGhzRDNYR250VE1XMzRHcHVCMXRiSnp5QmpxbHVGSEdlbUoK",
      "endpoints": ["https://github.com/gaerae/playpets/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
