node_modules/
src-tauri/target/
src-tauri/gen/schemas/
# Packages handed off by pnpm run dist:* and the store pictures (docs/repository-layout.md).
/release/
# Local audits, review captures, backups and experiments; never a source or a package.
/scratch/
*.log
# Sanitized parser fixtures are source, not local process logs.
!tests/fixtures/**/*.log
# a local data folder for development (docs/getting-started.md)
/.dev-data/
/.dev-data-*/
# Optional local npm/browser caches and test reports; fixtures remain visible.
/.npm/
/.cache/
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
.DS_Store
.env*
# A future template contains placeholders only; never copy live credentials into it.
!/.env.example
# editors and tools
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
# editor backups and leftovers of a merge or patch that did not apply cleanly
*~
*.orig
*.rej
# local assistant settings and the worktrees agent sessions make inside the checkout
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
# website: generated from docs/ and assets/ by scripts/site-prepare.mjs, built by vitepress
website/dev/
website/public/icon.svg
website/public/favicon.png
website/public/favicon.ico
website/public/pets/
website/public/creator-kit/
website/public/yard/
website/.vitepress/cache/
website/.vitepress/.temp/
website/.vitepress/dist/
website/.vitepress/generated.json
# keys and certificates never belong here (an Apple App Store Connect API key is a .p8)
/.credentials/
*.pem
*.p12
*.p8
*.pfx
*.key
# mobile signing stores and Apple provisioning profiles
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
# Windows folder files
Thumbs.db
desktop.ini

# Ownership and regeneration commands: docs/repository-layout.md.
# Ignore rules do not remove files already tracked by Git.
