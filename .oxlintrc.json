{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "scratch/**",
    "release/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "website/dev/**",
    "website/public/pets/**",
    "website/public/creator-kit/**",
    "website/public/yard/**",
    "website/.vitepress/generated.json",
    "website/.vitepress/cache/**",
    "website/.vitepress/.temp/**",
    "website/.vitepress/dist/**"
  ],
  "rules": {
    "eslint/no-unused-expressions": ["error", { "allowTernary": true }],
    // A name used but never declared or imported (a missing import) fails at run time only, in the
    // one path that reaches it; this finds it before then.
    "eslint/no-undef": "error",
    // The rest are the checks Biome's recommended set made outside Oxlint's correctness category.
    "eslint/array-callback-return": "error",
    "eslint/default-case-last": "error",
    // `== null` stays allowed, as Biome's noDoubleEquals allowed it: one check for null and undefined.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-array-constructor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-constructor-return": "error",
    "eslint/no-else-return": "error",
    "eslint/no-extra-boolean-cast": "error",
    "eslint/no-extra-label": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-inner-declarations": "error",
    "eslint/no-label-var": "error",
    "eslint/no-labels": "error",
    "eslint/no-lone-blocks": "error",
    "eslint/no-proto": "error",
    "eslint/no-redeclare": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-sequences": "error",
    "eslint/no-template-curly-in-string": "error",
    "eslint/no-unneeded-ternary": "error",
    // Only a use that runs before its declaration, as Biome's noInvalidUseBeforeDeclaration: a
    // function body may name a later declaration, since it runs after the module has loaded.
    "eslint/no-use-before-define": ["error", { "functions": false, "classes": false, "variables": false }],
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/no-useless-escape": "error",
    "eslint/no-useless-rename": "error",
    "eslint/no-var": "error",
    "eslint/prefer-arrow-callback": "error",
    // A `let` that a cleanup reads before the one assignment stays a `let`, as with Biome's useConst.
    "eslint/prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
    "eslint/prefer-exponentiation-operator": "error",
    "eslint/prefer-numeric-literals": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/prefer-regex-literals": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/radix": "error",
    "oxc/no-accumulating-spread": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-dom-node-text-content": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-node-protocol": "error",
    "vue/no-import-compiler-macros": "error"
  },
  "overrides": [
    {
      // Vue's compiler supplies these to <script setup> without an import.
      "files": ["**/*.vue"],
      "globals": { "defineProps": "readonly", "defineEmits": "readonly", "withDefaults": "readonly" }
    }
  ]
}
