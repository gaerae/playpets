<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows package identity and version are filled by scripts/msix-manifest.mjs.
     The Store publisher is copied exactly from Partner Center; local tests use a separate identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCHITECTURE@" />
  <Properties>
    <DisplayName>PlayPets</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ko-KR" />
    <Resource Language="ja-JP" />
    <Resource Language="zh-Hans" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <!-- An ordinary desktop app: windows over the desktop, the tray, child processes (claude, codex). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="PlayPets" Executable="playpets.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PlayPets"
        Description="A yard where your pets talk to each other"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Coding agents run `playpets hook …` and `playpets mcp`. A packaged binary cannot be started
             by its path, so the package puts playpets.exe on the PATH as an alias. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="playpets.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="playpets.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
