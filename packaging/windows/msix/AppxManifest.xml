<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows package (MSIX). @VERSION@ and @PUBLISHER@ are filled in by packaging/windows/build.sh.
     Publisher must equal the subject of the certificate the package is signed with: the test
     certificate for trying the package out, the Partner Center publisher id for the Store. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="gaerae.PlayPets" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>PlayPets</DisplayName>
    <PublisherDisplayName>gaerae</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <!-- An ordinary desktop app: windows over the desktop, the tray, child processes (claude, codex). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="PlayPets" Executable="playpets.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PlayPets"
        Description="A desktop pet you can talk to, powered by your own AI subscription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Coding agents run `playpets hook …` and `playpets mcp`. A packaged binary cannot be started
             by its path, so the package puts playpets.exe on the PATH as an alias. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="playpets.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="playpets.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
